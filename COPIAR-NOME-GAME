local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local GuiService = game:GetService("GuiService")

local LocalPlayer = Players.LocalPlayer
local placeId = game.PlaceId

local success, gameInfo = pcall(function()
    return MarketplaceService:GetProductInfo(placeId)
end)

local gameName = success and gameInfo.Name or "Nome Desconhecido"

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "GameNameGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = (syn and game.CoreGui) or (gethui and gethui()) or Players.LocalPlayer:WaitForChild("PlayerGui")

local openButton = Instance.new("TextButton")
openButton.Size = UDim2.new(0, 120, 0, 40)
openButton.Position = UDim2.new(0, 10, 0, 10)
openButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
openButton.Text = "ABRIR MENU"
openButton.Font = Enum.Font.Gotham
openButton.TextSize = 16
openButton.TextColor3 = Color3.fromRGB(255, 255, 255)
openButton.Parent = screenGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 100)
frame.Position = UDim2.new(0.5, -150, 0.5, -50)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.Visible = false
frame.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 40)
title.Position = UDim2.new(0, 10, 0, 10)
title.BackgroundTransparency = 1
title.Text = gameName
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = frame

local copyButton = Instance.new("TextButton")
copyButton.Size = UDim2.new(0, 120, 0, 30)
copyButton.Position = UDim2.new(0.5, -60, 1, -40)
copyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
copyButton.Text = "COPIAR NOME"
copyButton.Font = Enum.Font.Gotham
copyButton.TextSize = 16
copyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
copyButton.Parent = frame

local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(0, 100, 0, 30)
closeButton.Position = UDim2.new(1, -110, 0, 10)
closeButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
closeButton.Text = "FECHAR"
closeButton.Font = Enum.Font.Gotham
closeButton.TextSize = 16
closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
closeButton.Parent = frame

local notification = Instance.new("TextLabel")
notification.Size = UDim2.new(1, 0, 0, 30)
notification.Position = UDim2.new(0, 0, 1, 0)
notification.BackgroundTransparency = 1
notification.Text = ""
notification.TextColor3 = Color3.fromRGB(0, 255, 0)
notification.TextScaled = true
notification.Font = Enum.Font.Gotham
notification.Parent = frame

copyButton.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(gameName)
    elseif Clipboard and Clipboard.set then
        Clipboard.set(gameName)
    end
    notification.Text = "Nome copiado com sucesso!"
    task.delay(2, function()
        notification.Text = ""
    end)
end)

openButton.MouseButton1Click:Connect(function()
    frame.Visible = true
    openButton.Visible = false
end)

closeButton.MouseButton1Click:Connect(function()
    frame.Visible = false
    openButton.Visible = true
end)
